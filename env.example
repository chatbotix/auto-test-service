# App configuration
BACKEND_BASE_URL=
BACKEND_AUTH=
AUTH_TOKEN=ABC1234
PORT=3000

# MongoDB
# ถ้าใส่ MONGO_URI จะใช้ค่านี้เลย (ใส่ user/pass ใน URI ได้) และไม่สนใจ MONGO_HOST/PORT/DB/AUTH_SOURCE

MONGO_URI=
MONGO_HOST=
MONGO_PORT=27017
MONGO_DB=kpat_core_backend
MONGO_AUTH_SOURCE=admin
# user/pass แยก (ไม่ต้อง encode อักขระพิเศษ)
MONGO_USER=
MONGO_PASSWORD=

# SSH tunnel (เมื่อ SSH_ENABLED=true และไม่ได้ใส่ MONGO_URI จะต่อ 127.0.0.1:SSH_LOCAL_PORT ให้อัตโนมัติ)
SSH_ENABLED=true
SSH_HOST=
SSH_PORT=
SSH_USER=asol
SSH_PASSWORD=
SSH_PRIVATE_KEY_PATH=
SSH_PASSPHRASE=
SSH_DST_HOST=
SSH_DST_PORT=
SSH_LOCAL_PORT=

# Auto QC job (Phase 1)
QC_JOB_ENABLED=true
# cron ทุก 1 ชม.
QC_JOB_CRON=0 * * * *
QC_LOOKBACK_HOURS=1
QC_SAMPLE_PERCENT=10
# สายต้องยาวอย่างน้อยกี่วินาทีถึงจะถูกสุ่มมาประเมิน (0 = ไม่กรอง)
QC_MIN_DURATION_SECONDS=10
QC_CONCURRENCY=3
QC_MAX_RETRY=2
# ตรวจว่า AI ได้ฟังเสียงจริง: แปลง audio token เป็นวินาทีแล้วเทียบกับความยาวสาย
GEMINI_AUDIO_TOKENS_PER_SECOND=25
QC_AUDIO_TOLERANCE_PCT=20
QC_AUDIO_TOLERANCE_MIN_SECONDS=3
QC_PROMPT_FILE=prompts/qc_judge.txt
QC_SCHEMA_FILE=prompts/qc_result.schema.json

# Gemini (Vertex AI) ใช้ SA key ในโฟลเดอร์ key/
SERVICE_ACCOUNT_FILE=service-account.json
# ไม่ใส่จะใช้ project_id จากไฟล์ SA
GCP_PROJECT_ID=
GCP_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0
# timeout ต่อ request ที่ส่งให้ Gemini (มิลลิวินาที) เกินแล้วนับเป็น error และ retry ตาม QC_MAX_RETRY
GEMINI_TIMEOUT_MS=120000
# อายุ signed URL ของไฟล์เสียงที่ส่งให้หน้า UI (นาที)
GCS_SIGNED_URL_TTL_MINUTES=60
